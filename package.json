{
  "name": "familie-tilbake-frontend",
  "version": "0.0.1",
  "main": "node_dist/server.js",
  "author": "Nav - tilbake",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node --enable-source-maps node_dist/server.js",
    "start:dev": "pnpm build:server && NODE_ENV=development node --enable-source-maps node_dist/server.js",
    "build": "pnpm check && pnpm typecheck && pnpm build:prod",
    "build:client": "vite build --config src/frontend/vite.config.js",
    "build:server": "node esbuild.backend.mjs",
    "build:prod": "pnpm build:server && pnpm build:client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/frontend/tsconfig.json",
    "check": "biome check src",
    "check:fix": "biome check --write src",
    "prepare": "husky",
    "generate-types": "pnpm dlx --package typescript@6.0.3 --package @hey-api/openapi-ts@0.99.0 openapi-ts"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true --error-on-warnings"
    ]
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "2.9.0",
    "@hookform/resolvers": "5.7.1",
    "@navikt/aksel-icons": "8.16.1",
    "@navikt/ds-css": "8.16.1",
    "@navikt/ds-react": "8.16.1",
    "@navikt/ds-tailwind": "8.16.1",
    "@sentry/browser": "10.69.0",
    "@sentry/core": "10.69.0",
    "@tanstack/react-query": "5.101.4",
    "axios": "1.19.0",
    "compression": "1.8.1",
    "connect-redis": "10.0.0",
    "constate": "4.0.0",
    "cookie-parser": "1.4.7",
    "countries-list": "3.4.1",
    "date-fns": "4.4.0",
    "deep-equal": "2.2.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "express-static-gzip": "3.0.1",
    "http-proxy-middleware": "4.2.0",
    "prom-client": "15.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router": "8.3.0",
    "redis": "6.2.0",
    "tailwindcss": "4.3.3",
    "winston": "3.19.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/react": "4.12.1",
    "@biomejs/biome": "2.5.7",
    "@hey-api/openapi-ts": "0.99.0",
    "@peculiar/webcrypto": "1.7.1",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/deep-equal": "1.0.4",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.1",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-compression": "0.5.1",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.0.4"
}
